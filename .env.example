# Public Clerk frontend key. Vite variables are bundled into browser assets.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key

# NOTE: API origins are currently hard-coded in src/services and src/redux.
# These variables are documentation placeholders until the application code
# is updated to read them. Never place private credentials in VITE_* variables.
VITE_FLIGHT_API_URL=http://localhost:3000
VITE_BOOKING_API_URL=http://localhost:4000
